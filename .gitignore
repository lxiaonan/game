# 只有运行时文件需要进仓库,GitHub Pages 直接从仓库发出去。
# 这些是开发用的,不要提交:
node_modules/
dist/
docs/
tools/shots/
.perf-profile-*/
.chrome-perf-profile/
.mem-profile-*/
.check-profile-*/
.smoke-profile-*/
__pycache__/
*.pyc

# AI 生图原稿(53MB),只有重新生成素材时才需要,浏览器不会请求
assets/raw/

# 别的工具把 %SystemDrive% 变量展开失败后复制进来的系统缓存垃圾
%SystemDrive%/

# 本地启动日志
gen2.log

# 别的会话把两个完全无关的项目丢进了这个目录(一个是 777MB 的 hypit-demo,
# 里面还塞着 ffmpeg.exe / uv.exe / npm 缓存和一个内嵌 git 仓库;另一个是
# pelican-on-a-bike)。它们不是《熊二的世界》的一部分,而 推送到GitHub.bat
# 用的是 `git add -A` —— 不挡掉就会把这几百兆一起提交,GitHub 直接拒收。
hypit-demo/
pelican-on-a-bike/
